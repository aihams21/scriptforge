[Desktop Entry]
Type=Application
Version=1.0
Name=ScriptForge (terminal)
GenericName=Script wrapper
Comment=Turn any bash, python or PowerShell script into a usable app
Exec=@EXEC@ tui
Icon=scriptforge
Terminal=true
Categories=Development;
Keywords=pentest;security;bash;python;wrapper;ctf;kali;automation;gui;
StartupNotify=true
StartupWMClass=ScriptForge
